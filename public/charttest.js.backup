// =====================================================
// KINGDOM WAYS CHURCH
// CONNECT HUB
// PART 1 - APPLICATION FOUNDATION
// =====================================================

"use strict";

console.log("========================================");
console.log("KINGDOM WAYS CONNECT HUB");
console.log("PART 1 - APPLICATION FOUNDATION");
console.log("========================================");

// =====================================================
// CONFIGURATION
// =====================================================

const API = window.location.origin;
const SESSION_KEY = "memberSession";

// =====================================================
// APPLICATION STATE
// =====================================================

const APP = {

    socket: null,

    connected: false,

    reconnectTimer: null,

    heartbeatTimer: null,

    typingTimer: null,

    currentMember: null,

    currentConversation: null,

    conversations: [],

    messages: [],

    onlineMembers: []

};

// =====================================================
// DOM CACHE
// =====================================================

const DOM = {

    // Hidden values

    currentMemberNumber:
        document.getElementById("currentMemberNumber"),

    currentConversationId:
        document.getElementById("currentConversationId"),

    currentConversationType:
        document.getElementById("currentConversationType"),

    currentUsername:
        document.getElementById("currentUsername"),

    currentRole:
        document.getElementById("currentRole"),

    // Left sidebar

    memberName:
        document.getElementById("memberName"),

    memberNumber:
        document.getElementById("memberNumber"),

    memberStatus:
        document.getElementById("memberStatus"),

    memberPhoto:
        document.getElementById("memberPhoto"),

    onlineIndicator:
        document.getElementById("onlineIndicator"),

    profileButton:
        document.getElementById("profileButton"),

    settingsButton:
        document.getElementById("settingsButton"),

    conversationList:
        document.getElementById("conversationList"),

    // Header

    activeChatName:
        document.getElementById("activeChatName"),

    activeChatInfo:
        document.getElementById("activeChatInfo"),

    activeChatPhoto:
        document.getElementById("activeChatPhoto"),

    activeOnlineIndicator:
        document.getElementById("activeOnlineIndicator"),

    // Chat

    messageContainer:
        document.getElementById("messageContainer"),

    messageForm:
        document.getElementById("messageForm"),

    messageInput:
        document.getElementById("messageInput"),

    sendButton:
        document.getElementById("sendBtn"),

    typingArea:
        document.getElementById("typingArea"),

    scrollBottomButton:
        document.getElementById("scrollBottomBtn"),

    connectionStatus:
        document.getElementById("connectionStatus")

};

// =====================================================
// PROFILE IMAGE
// =====================================================

function profileImage(path) {

    if (!path || path.trim() === "") {

        return "images/default-avatar.png";

    }

    return path;

}

// =====================================================
// CONNECTION STATUS
// =====================================================

function setConnectionStatus(text, online) {

    if (!DOM.connectionStatus) return;

    DOM.connectionStatus.classList.remove(
        "hidden",
        "online",
        "offline"
    );

    DOM.connectionStatus.classList.add(
        online ? "online" : "offline"
    );

    DOM.connectionStatus.innerHTML = `

        <i class="fa-solid fa-wifi"></i>

        <span>${text}</span>

    `;

}

// =====================================================
// RESTORE SESSION
// =====================================================

function restoreSession() {

    const raw = localStorage.getItem(SESSION_KEY);

    if (!raw) {

        console.warn("Member session not found.");

        window.location.href = "login.html";

        return false;

    }

    try {

        APP.currentMember = JSON.parse(raw);

        console.log("Session restored.");

        console.log(APP.currentMember);

        return true;

    }

    catch (error) {

        console.error(error);

        localStorage.removeItem(SESSION_KEY);

        window.location.href = "login.html";

        return false;

    }

}

// =====================================================
// LOAD MEMBER
// =====================================================

function loadCurrentMember() {

    if (!APP.currentMember) return;

    const member = APP.currentMember;

    DOM.memberName.textContent =
        member.full_name;

    DOM.memberNumber.textContent =
        member.member_number;

    DOM.memberStatus.textContent =
        "Available";

    DOM.memberPhoto.src =
        profileImage(member.profile_picture);

    DOM.currentMemberNumber.value =
        member.member_number;

    DOM.currentUsername.value =
        member.username;

    DOM.currentRole.value =
        member.role || "member";

    console.log("Current member loaded.");

}

// =====================================================
// INITIALIZE APPLICATION
// =====================================================

function initializeApplication() {

    console.log("Initializing application...");

    if (!restoreSession()) {

        return;

    }

    loadCurrentMember();

    setConnectionStatus(
        "Disconnected",
        false
    );

    console.log("Application foundation ready.");

}

// =====================================================
// START APPLICATION
// =====================================================

window.addEventListener(

    "load",

    initializeApplication

);

// =====================================================
// KINGDOM WAYS CHURCH
// CONNECT HUB
// PART 2 - WEBSOCKET ENGINE
// =====================================================

// =====================================================
// CONNECT TO WEBSOCKET
// =====================================================

function connectWebSocket() {

    if (!APP.currentMember) {
        console.error("No logged in member.");
        return;
    }

    // Prevent duplicate connections
    if (
        APP.socket &&
        (
            APP.socket.readyState === WebSocket.OPEN ||
            APP.socket.readyState === WebSocket.CONNECTING
        )
    ) {
        console.log("WebSocket already connected.");
        return;
    }

    const protocol =
        window.location.protocol === "https:"
            ? "wss:"
            : "ws:";

    const url =
        `${protocol}//${window.location.host}/ws/chat/${APP.currentMember.member_number}`;

    console.log("Connecting:", url);

    setConnectionStatus("Connecting...", false);

    APP.socket = new WebSocket(url);

    // =================================================
    // CONNECTED
    // =================================================

    APP.socket.onopen = function () {

        console.log("✅ WebSocket Connected");

        APP.connected = true;

        setConnectionStatus("Connected", true);

        if (APP.reconnectTimer) {

            clearTimeout(APP.reconnectTimer);

            APP.reconnectTimer = null;

        }

        socketSend({
            type: "ping"
        });

    };

    // =================================================
    // SERVER MESSAGE
    // =================================================

    APP.socket.onmessage = function (event) {

        let data;

        try {

            data = JSON.parse(event.data);

        }

        catch (error) {

            console.error("Invalid WebSocket JSON");

            return;

        }

        console.log("WS:", data);

        switch (data.type) {

            case "connected":

                console.log(data.message);

                break;

            case "pong":

                console.log("Heartbeat OK");

                break;

            case "online_members":

                APP.onlineMembers = data.members || [];

                console.log("Online Members:", APP.onlineMembers);

                updateOnlineIndicators();

                break;

            case "message":

                if (typeof receiveSocketMessage === "function") {

                    receiveSocketMessage(data);

                }

                break;

            case "typing":

                if (typeof showTypingIndicator === "function") {

                    showTypingIndicator(data.sender);

                }

                break;

            default:

                console.log("Unknown socket packet:", data);

        }

    };

    // =================================================
    // ERROR
    // =================================================

    APP.socket.onerror = function (error) {

        console.error("WebSocket Error", error);

    };

    // =================================================
    // CLOSED
    // =================================================

    APP.socket.onclose = function (event) {

        console.warn("Socket Closed");

        console.log("Code:", event.code);

        console.log("Reason:", event.reason);

        APP.connected = false;

        APP.socket = null;

        setConnectionStatus("Disconnected", false);

        if (event.code !== 1000) {

            APP.reconnectTimer = setTimeout(function () {

                console.log("Reconnecting...");

                connectWebSocket();

            }, 3000);

        }

    };

}

// =====================================================
// SEND JSON THROUGH SOCKET
// =====================================================

function socketSend(payload) {

    if (!APP.socket) {

        return false;

    }

    if (APP.socket.readyState !== WebSocket.OPEN) {

        return false;

    }

    APP.socket.send(

        JSON.stringify(payload)

    );

    return true;

}

// =====================================================
// HEARTBEAT
// =====================================================

APP.heartbeatTimer = setInterval(function () {

    if (!APP.connected) return;

    socketSend({

        type: "ping"

    });

}, 30000);

// =====================================================
// UPDATE ONLINE INDICATORS
// =====================================================

function updateOnlineIndicators() {

    if (!APP.currentMember) return;

    const online =
        APP.onlineMembers.includes(
            APP.currentMember.member_number
        );

    if (DOM.onlineIndicator) {

        DOM.onlineIndicator.classList.remove(
            "online-dot",
            "offline-dot"
        );

        DOM.onlineIndicator.classList.add(

            online
                ? "online-dot"
                : "offline-dot"

        );

    }

}

// =====================================================
// CLOSE SOCKET
// =====================================================

window.addEventListener(

    "beforeunload",

    function () {

        if (!APP.socket) return;

        APP.socket.close(

            1000,

            "Leaving page"

        );

    }

);

// =====================================================
// START WEBSOCKET
// =====================================================

window.addEventListener(

    "load",

    function () {

        connectWebSocket();

    }

);


// =====================================================
// KINGDOM WAYS CHURCH
// CONNECT HUB
// PART 3 - CONVERSATIONS ENGINE
// =====================================================

console.log("Loading Conversation Engine...");

// =====================================================
// LOAD CONVERSATIONS
// =====================================================

async function loadConversations() {

    if (!APP.currentMember) {
        console.error("No active member.");
        return;
    }

    try {

        const response = await fetch(
            `${API}/api/chat/conversations/${APP.currentMember.member_number}`
        );

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();

        if (!data.success) {
            console.error("Conversation request failed.");
            return;
        }

        APP.conversations = data.conversations || [];

        console.log(
            "Conversations Loaded:",
            APP.conversations.length
        );

        renderConversationList();

    }

    catch (error) {

        console.error(
            "Conversation Load Error:",
            error
        );

    }

}

// =====================================================
// RENDER CONVERSATIONS
// =====================================================

function renderConversationList() {

    if (!DOM.conversationList)
        return;

    DOM.conversationList.innerHTML = "";

    if (APP.conversations.length === 0) {

        DOM.conversationList.innerHTML = `

            <div class="empty-chat">

                <i class="fa-solid fa-comments"></i>

                <h3>No Conversations</h3>

                <p>You have no conversations yet.</p>

            </div>

        `;

        return;

    }

    APP.conversations.forEach(conversation => {

        const templateId =

            conversation.type === "private"

                ? "privateConversationTemplate"

                : "conversationTemplate";

        const template =
            document.getElementById(templateId);

        if (!template) {

            console.error(
                "Template Missing:",
                templateId
            );

            return;

        }

        const card =
            template.content.firstElementChild.cloneNode(true);

        card.dataset.id = conversation.id;

        card.dataset.type = conversation.type;

        card.dataset.member =
            conversation.other_member || "";

        const image =
            card.querySelector(".conversation-image");

        if (image) {

            image.src =
                profileImage(conversation.image);

        }

        const name =
            card.querySelector(".conversation-name");

        if (name) {

            name.textContent =
                conversation.name || "Conversation";

        }

        const last =
            card.querySelector(".conversation-last-message");

        if (last) {

            last.textContent =
                conversation.last_message ||
                "No messages";

        }

        const time =
            card.querySelector(".conversation-time");

        if (time) {

            time.textContent =
                formatConversationTime(
                    conversation.last_message_at
                );

        }

        card.addEventListener(

            "click",

            function () {

                selectConversation(
                    conversation,
                    card
                );

            }

        );

        DOM.conversationList.appendChild(card);

    });

}

// =====================================================
// SELECT CONVERSATION
// =====================================================

function selectConversation(conversation, element) {

    APP.currentConversation = conversation;

    if (DOM.currentConversationId)
        DOM.currentConversationId.value =
            conversation.id;

    if (DOM.currentConversationType)
        DOM.currentConversationType.value =
            conversation.type;

    document
        .querySelectorAll(".conversation-item")
        .forEach(item => {

            item.classList.remove("active");

        });

    element.classList.add("active");

    if (DOM.activeChatName)
        DOM.activeChatName.textContent =
            conversation.name;

    if (DOM.activeChatInfo)
        DOM.activeChatInfo.textContent =
            conversation.type;

    if (DOM.activeChatPhoto)
        DOM.activeChatPhoto.src =
            profileImage(conversation.image);

    console.log(
        "Conversation Selected:",
        conversation.id
    );

    // Part 4
    if (typeof loadMessages === "function") {

        loadMessages(conversation.id);

    }

}

// =====================================================
// FORMAT TIME
// =====================================================

function formatConversationTime(date) {

    if (!date)
        return "";

    const d = new Date(date);

    return d.toLocaleTimeString([], {

        hour: "2-digit",

        minute: "2-digit"

    });

}

// =====================================================
// AUTO LOAD
// =====================================================

window.addEventListener(

    "load",

    function () {

        loadConversations();

    }

);


