# ===========================================
# KINGDOM WAYS CHURCH CMS
# Environment Configuration
# ===========================================
#
# DATABASE: Choose ONE configuration below
# ===========================================

# ---------- OFFLINE (SQLite) ----------
# Default: uses local file church_cms.db
# No server needed, works on any machine
DATABASE_URL=sqlite:///./church_cms.db

# ---------- ONLINE (PostgreSQL / Neon) ----------
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ===========================================
# SECURITY
# ===========================================
SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_ADMIN=false
CORS_ORIGINS=http://localhost:8000

# ===========================================
# M-PESA (Optional - only for live payments)
# ===========================================
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ===========================================
# CLOUDINARY (OPTIONAL)
# When set, uploads are stored on Cloudinary's free CDN (no credit card).
# Leave blank to store uploads on the local disk (local dev).
# Get these free from dashboard.cloudinary.com -> Dashboard -> Account Details
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
